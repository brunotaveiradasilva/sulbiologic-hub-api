DB_URL=jdbc:mysql://localhost:3306/almoxarifado
DB_USERNAME=almoxarifado
DB_PASSWORD=almoxarifado
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://brunotaveiradasilva.github.io
PORT=8080

# Assina os tokens de login — gere um valor forte e único antes de publicar a API
# (ex: openssl rand -base64 48). Nunca reaproveite o valor de exemplo abaixo.
JWT_SECRET=troque-isto-por-uma-chave-longa-e-aleatoria-antes-de-publicar
JWT_VALIDADE_HORAS=168

# Login criado sozinho na primeira vez que a API sobe sem nenhum usuário cadastrado.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=escolha-uma-senha-forte

# API da ADS (histórico de vendas), para calcular o "realizado" das metas — ver README.
ADS_API_URL=https://adsapi.com.br
ADS_API_KEY=
ADS_USER_AGENT=SulBiologic
ADS_ESPECIFICO_ID=074
ADS_CNPJ_DISTRIBUIDORA=

# Cloud Run (ver README): lá a instância desliga sem acesso, então os jobs das 6h ficam desligados
# e o Cloud Scheduler chama POST /api/interno/sincronizacao-diaria com o header X-Cron-Token.
AGENDADOR_INTERNO=true
CRON_TOKEN=
